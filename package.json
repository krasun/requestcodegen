{
  "name": "requestcodegen",
  "version": "0.1.1",
  "description": "Parse curl commands and raw HTTP requests, and generate HTTP client code in different programming languages.",
  "keywords": [
    "curl",
    "curl-converter",
    "http",
    "code-generation",
    "fetch",
    "axios",
    "python-requests",
    "guzzle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krasun/requestcodegen.git"
  },
  "author": "Dmytro Krasun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/krasun/requestcodegen/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "axios": "^1.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:package": "node scripts/test-package.mjs",
    "examples": "tsx ./src/scripts/examples.ts ./examples.md",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:package"
  }
}
